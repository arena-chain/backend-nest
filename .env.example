# App
PORT=3000

# Redis (BullMQ — highlight generation queue)
# Use either REDIS_URL or host/port:
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to false on API-only instances if a separate worker consumes the queue
HIGHLIGHT_WORKER_ENABLED=true
# Set to false when Redis is not running (local dev). No Redis connections; enqueue returns null / error.
HIGHLIGHT_QUEUE_ENABLED=true
JWT_SECRET=change-me
# Atlas SRV example (include DB path OR rely on MONGO_DB_NAME below):
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/arenachain
# Must match the database name in Atlas where your collections live (e.g. users). Defaults to arenachain.
MONGO_DB_NAME=arenachain
FRONTEND_URL=http://localhost:5173

# ── Production (e.g. Render) ─────────────────────────────────────────────
# PORT is usually injected by the host (Render sets PORT automatically).
# Matchmaking WebSockets use in-memory socket maps: run exactly ONE web instance
# unless you add Redis adapter / sticky sessions later.
#
# OAuth redirect examples (global prefix is /api):
# GOOGLE_CALLBACK_URL=https://YOUR-SERVICE.onrender.com/api/auth/google/redirect
# STEAM_RETURN_URL=https://YOUR-SERVICE.onrender.com/api/auth/steam/return
# STEAM_REALM=https://YOUR-SERVICE.onrender.com/
#
# MongoDB Atlas: allow connections from anywhere (0.0.0.0/0) or Render outbound IPs.
# If login returns "Invalid credentials" but users exist in Atlas, Render was likely using the wrong DB
# (e.g. default "test"). Set MONGO_DB_NAME=arenachain to match your Data Explorer database name.

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="Arena-Chain" <your-email@gmail.com>

# Google Auth (Web)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/redirect

# Google Auth (Android / Mobile)
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id
GOOGLE_ANDROID_CLIENT_SECRET=your_google_android_client_secret

# Steam Auth
STEAM_API_KEY=your_steam_api_key
STEAM_RETURN_URL=http://localhost:3000/auth/steam/return
STEAM_REALM=http://localhost:3000/

# Optional TURN server for stronger WebRTC reliability across browsers/networks
TURN_URLS=turn:your-turn-server.example.com:3478?transport=udp,turn:your-turn-server.example.com:3478?transport=tcp
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_password

# Optional Metered/Open Relay TURN credentials endpoint
# Example shape:
# https://yourappname.metered.live/api/v1/turn/credentials?apiKey=YOUR_API_KEY
METERED_TURN_CREDENTIALS_URL=

# Or provide Metered credentials separately instead of one full URL
METERED_TURN_DOMAIN=
METERED_TURN_API_KEY=

# ── Game token (GTK on-chain) — optional branding for UI ───────────────────
# Local checklist (avoids 503 on GET /api/currency/game-token/config):
#
# Persistent Anvil (deploy once; same addresses after Anvil restarts):
# 1) Terminal A: npm run gtk:anvil   (uses game-token/anvil-state/state.json — load on start, dump on Ctrl+C)
# 2) One-time (or after you delete state.json): Terminal B: npm run gtk:bootstrap
#    → deploys GameToken and writes GAME_TOKEN_CONTRACT_ADDRESS + RPC_URL into .env
# 3) Restart Nest after the first bootstrap (or any .env change)
# Later: only start gtk:anvil again — no redeploy, no .env edits, as long as you keep the state file.
#
# Ephemeral Anvil (plain `anvil` with no --state): every restart is an empty chain — redeploy and
# update GAME_TOKEN_CONTRACT_ADDRESS from game-token/broadcast/Deploy.s.sol/31337/run-latest.json
# If logs show CALL_EXCEPTION / symbol() with data="0x": GAME_TOKEN_CONTRACT_ADDRESS has no valid ERC-20 on this RPC
# (wrong chain, stale address after a plain anvil reset, or typo). Fix: use `npm run gtk:anvil` + bootstrap, or redeploy + update .env.
# When RPC/Anvil is down, non-production still returns /currency/game-token/config from .env (opt out: GTK_CONFIG_FALLBACK=false).
# GAME_TOKEN_CONTRACT_ADDRESS=
# RPC_URL= or ALCHEMY_API_KEY + ALCHEMY_NETWORK (same chain as contract)
# Optional fallback tuning (defaults: chain 31337, decimals 18, name GameToken, symbol GTK):
# GAME_TOKEN_CHAIN_ID=31337
# GAME_TOKEN_DECIMALS=18
# GAME_TOKEN_FALLBACK_NAME=GameToken
# GAME_TOKEN_FALLBACK_SYMBOL=GTK
# Optional: show a friendly name in the app while the ERC-20 keeps its on-chain symbol (e.g. GTK).
# GAME_TOKEN_DISPLAY_NAME=Vex currency
# GAME_TOKEN_DISPLAY_SYMBOL=VEX
# Dev only: allow POST /api/currency/game-token/credit-test (server must own GameToken for mint).
# GTK_ALLOW_TEST_CREDIT=false
# Simulated “buy” (mint) — separate from test credit for ledger categorisation.
# Also gates POST /api/currency/packs/:id/purchase until a real payment webhook calls fulfillment.
# GTK_ALLOW_PURCHASE_SIMULATION=false
# Record simulated in-app spends in Mongo only (no on-chain transfer).
# GTK_ALLOW_ECONOMY_SIMULATION=false

# Live streaming note
# The app uses browser WebRTC live for:
# 1. Screen share
# 2. Camera live
# 3. Screen + camera live
